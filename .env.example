# Firebase web app config (Project settings → General → Your apps). Set these as GitHub Actions
# repository variables, or in .env.local for development. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# App Check (required by Firebase AI Logic): reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# …or a reCAPTCHA v3 site key (simpler, free).
VITE_RECAPTCHA_V3_KEY=
# Local development only: prints an App Check debug token in the console to register.
VITE_APPCHECK_DEBUG=false
